# Public Consumet API base URL. Defaults to https://api.consumet.org.
# Self-host https://github.com/consumet/api for reliability in production.
NEXT_PUBLIC_CONSUMET_URL=

# NextAuth (Auth.js v5)
AUTH_SECRET=
# On Vercel the URL is auto-detected; set manually for other hosts.
# AUTH_URL=https://your-domain.com

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://your-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres database for watchlist / history (Neon, Supabase, Railway, ...)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=
